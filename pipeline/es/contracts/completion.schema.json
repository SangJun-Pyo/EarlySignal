{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract": {
      "const": "earlysignal-data-v1"
    },
    "labeler": {
      "enum": [
        "keyword",
        "llm"
      ]
    },
    "status": {
      "const": "complete"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "console_months": {
      "type": "integer",
      "minimum": 0
    },
    "console_groups": {
      "type": "integer",
      "minimum": 0
    },
    "complaints": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_cells": {
      "type": "integer",
      "minimum": 0
    },
    "briefs": {
      "type": "integer",
      "minimum": 0
    },
    "cases": {
      "type": "integer",
      "minimum": 0
    },
    "file_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  },
  "required": [
    "contract",
    "labeler",
    "status",
    "files",
    "console_months",
    "console_groups",
    "complaints",
    "evidence_cells",
    "briefs",
    "cases",
    "file_sha256"
  ],
  "additionalProperties": false
}
