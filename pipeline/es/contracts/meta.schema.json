{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract": {
      "const": "earlysignal-data-v1"
    },
    "generated_at": {
      "type": "string"
    },
    "data_source": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "downloaded_at": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_local_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "license": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "downloaded_at",
        "observed_local_date",
        "license"
      ],
      "additionalProperties": false
    },
    "params": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "string"
        ]
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "dev": {
          "type": "object",
          "properties": {
            "case": {
              "type": "object",
              "properties": {
                "hits": {
                  "type": "integer",
                  "minimum": 0
                },
                "n": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "hits",
                "n"
              ],
              "additionalProperties": false
            },
            "control": {
              "type": "object",
              "properties": {
                "hits": {
                  "type": "integer",
                  "minimum": 0
                },
                "n": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "hits",
                "n"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "case",
            "control"
          ],
          "additionalProperties": false
        },
        "holdout": {
          "type": "object",
          "properties": {
            "case": {
              "type": "object",
              "properties": {
                "hits": {
                  "type": "integer",
                  "minimum": 0
                },
                "n": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "hits",
                "n"
              ],
              "additionalProperties": false
            },
            "control": {
              "type": "object",
              "properties": {
                "hits": {
                  "type": "integer",
                  "minimum": 0
                },
                "n": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "hits",
                "n"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "case",
            "control"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "dev",
        "holdout"
      ],
      "additionalProperties": false
    },
    "burden": {
      "type": "object",
      "properties": {
        "case_alerts_per_group_month": {
          "type": [
            "number",
            "null"
          ]
        },
        "control_alerts_per_group_month": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "case_alerts_per_group_month",
        "control_alerts_per_group_month"
      ],
      "additionalProperties": false
    },
    "labels": {
      "type": "object",
      "properties": {
        "llm_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "llm_labeled": {
          "type": "integer",
          "minimum": 0
        },
        "sample_agreement": {
          "type": "object",
          "properties": {
            "agree": {
              "type": "integer",
              "minimum": 0
            },
            "n": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "agree",
            "n"
          ],
          "additionalProperties": false
        },
        "human_check": {
          "type": "object",
          "properties": {
            "n": {
              "type": "integer",
              "minimum": 0
            },
            "kw_correct": {
              "type": [
                "integer",
                "null"
              ]
            },
            "llm_correct": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "n",
            "kw_correct",
            "llm_correct"
          ],
          "additionalProperties": false
        },
        "cost_per_1k_usd": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "llm_model",
        "llm_labeled",
        "sample_agreement",
        "human_check",
        "cost_per_1k_usd"
      ],
      "additionalProperties": false
    },
    "validation_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "contract",
    "generated_at",
    "data_source",
    "params",
    "validation",
    "burden",
    "labels",
    "validation_notes"
  ],
  "additionalProperties": false
}
